{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hopper Download Manager",
  "version": "0.1.0",
  "identifier": "com.hopper.downloadmanager",
  "build": {
    "beforeBuildCommand": "npm --prefix ../ui run bundle",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hopper Download Manager",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
